<scene version="1.1"><project width="1000" height="500" fps="10" duration="10"/>
<assets><image id="img" src="i.png" width="200" height="100"/></assets><composition>
<group id="g" width="400" height="100">
<layer id="cv" asset="img" fit="cover" boxWidth="100" boxHeight="100" focusX="0.2" focusY="0.9"/>
<layer id="fl" asset="img" fit="fill" boxWidth="100" boxHeight="100"/>
<layer id="sd" asset="img" fit="scale-down" boxWidth="500" boxHeight="500"/>
<layer id="cb" asset="img" fit="contain-blur" boxWidth="100" boxHeight="100"/>
