<?xml version="1.0" encoding="UTF-8"?>
<!-- Layer audio inside a symbol: audio_av.mkv is 1 s of video whose audio is 440 Hz for 0-0.5 s
     and 880 Hz for 0.5-1 s. -->
<scene version="1.1">
  <project width="64" height="36" fps="10" duration="4"/>
  <assets>
    <video id="av" src="media/audio_av.mkv" width="64" height="36" fps="10" duration="1" hasAudio="true"/>
  </assets>
  <symbols>
    <symbol id="sym" width="64" height="36" duration="1">
      <layer id="inner" asset="av" start="0" end="1"/>
    </symbol>
  </symbols>
  <composition>
    <instance id="late" symbol="sym" start="1" end="2" clipIn="0.5" loop="1"/>
    <instance id="half" symbol="sym" start="2.5" end="4" speed="0.5"/>
  </composition>
</scene>
