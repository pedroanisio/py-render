<?xml version="1.0" encoding="UTF-8"?>
<!-- Time/pitch and restoration effects (tests/test_audio_full.py). Media generated by the tests:
     audio_tone440.wav 4 s mono 440 Hz; audio_noisy.wav 4 s white noise + 1 kHz from 1 s;
     audio_click.wav 0.1 s decaying click (tests/test_audio.py). -->
<scene version="1.1">
  <project width="64" height="36" fps="10" duration="4" seed="3"/>
  <assets>
    <audio id="tone" src="media/audio_tone440.wav" bpm="120"/>
    <audio id="noisy" src="media/audio_noisy.wav"/>
    <audio id="click" src="media/audio_click.wav"/>
  </assets>
  <markers>
    <beatGrid bpm="120" beatsPerBar="4"/>
  </markers>
  <composition/>
  <audioMix sampleRate="48000" channels="1" channelLayout="mono">
    <audioTrack id="fast" asset="tone" speed="1.5"/>
    <audioTrack id="varispeed" asset="tone" speed="1.5" preservePitch="false"/>
    <audioTrack id="slow" asset="tone" speed="0.75" clipOut="2"/>
    <audioTrack id="octave" asset="tone">
      <audioEffect type="pitch-shift" semitones="12"/>
    </audioTrack>
    <audioTrack id="clean" asset="noisy">
      <audioEffect type="noise-reduction" amount="0.6"/>
    </audioTrack>
    <audioTrack id="clean-profile" asset="noisy">
      <audioEffect type="noise-reduction" amount="0.6" attack="0.02" release="0.15">
        <param name="profileStart" value="0.1"/>
        <param name="profileEnd" value="0.9"/>
      </audioEffect>
    </audioTrack>
    <audioTrack id="echo" asset="click" start="0.5">
      <audioEffect type="delay" feedback="0.5" amount="0.5">
        <param name="sync" value="1/4"/>
      </audioEffect>
    </audioTrack>
    <audioTrack id="verb" asset="click" start="0.5">
      <audioEffect type="reverb" roomSize="0.8" width="1" amount="0.5" time="0.1">
        <param name="damping" value="0.2"/>
      </audioEffect>
    </audioTrack>
    <master volume="1" normalize="none"/>
  </audioMix>
</scene>
