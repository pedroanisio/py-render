      <layer id="p0-l6" asset="gen-grid" x="650" y="250" boxWidth="300" boxHeight="200" fit="contain"/>
      <shape id="p0-bg7" shape="rect" x="970" y="250" width="300" height="200" fill="#161D30FF"/>
      <layer id="p0-l7" asset="gen-stripes" x="970" y="250" boxWidth="300" boxHeight="200" fit="contain"/>
      <shape id="p0-bg8" shape="rect" x="10" y="490" width="300" height="200" fill="#161D30FF"/>
      <layer id="p0-l8" asset="gen-grain" x="10" y="490" boxWidth="300" boxHeight="200" fit="contain"/>
