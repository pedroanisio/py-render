<?xml version="1.0" encoding="UTF-8"?>
<!-- Audio mix demo for scenerender (tests/test_audio.py, tests/test_output.py).
     Media (generated by the tests into tests/fixtures/media/):
       audio_music.wav  4 s stereo 220 Hz + 330 Hz bed, -12 dBFS
       audio_voice.wav  mono 1 kHz "speech" bursts at 1.0-2.0 s and 2.5-3.0 s, -6 dBFS
       audio_click.wav  0.1 s decaying noise click -->
<scene version="1.1">
  <project width="320" height="180" fps="24" duration="4" seed="11" background="#101820FF"/>
  <metadata title="Audio demo" author="scenerender tests" description="tracks, buses, ducking, fades, automation"
            copyright="CC0" keywords="audio,test">
    <meta name="purpose" value="fixture"/>
  </metadata>
  <colorManagement workingSpace="linear-srgb" toneMapping="reinhard" exposure="0.5" looks="warm">
    <look id="warm" space="linear-srgb" slope="1.1,1.0,0.9" saturation="1.1"/>
  </colorManagement>
  <output id="out-mp4" path="audio_demo.mp4" codec="h264" width="160" height="90" crf="28" preset="ultrafast">
    <poster time="1.5" path="audio_demo_poster.png" format="png"/>
    <thumbnail time="1" path="audio_demo_thumb.jpg" format="jpeg" width="80"/>
    <destination kind="file" uri="delivered/"/>
    <destination kind="s3" uri="s3://bucket/audio_demo.mp4" credentials="default"/>
  </output>
  <output id="out-wav" path="audio_demo.wav" codec="audio-only" container="wav"/>
  <assets>
    <audio id="aud-music" src="media/audio_music.wav" duration="4" sampleRate="48000" channels="2" bpm="120"/>
    <audio id="aud-voice" src="media/audio_voice.wav" duration="4" sampleRate="48000" channels="1"/>
    <audio id="aud-click" src="media/audio_click.wav" duration="0.1" sampleRate="44100" channels="1"/>
  </assets>
  <markers>
    <marker id="m-click" time="0.5"/>
  </markers>
  <composition>
    <shape id="bg-bar" shape="rect" x="20" y="150" width="280" height="10" fill="#2A3350FF"/>
    <shape id="meter" shape="rect" x="20" y="150" width="280" height="10" fill="#3DD6D0FF" anchorX="0" scaleX="0.01">
      <link property="scaleX" source="audio:trk-voice" scale="3" offset="0.01" max="1"/>
    </shape>
    <shape id="dot" shape="ellipse" x="160" y="70" width="60" height="60" anchorX="30" anchorY="30" fill="#FFC23DFF">
      <link property="opacity" source="audio:bus-music:low" scale="4" offset="0.2" max="1"/>
    </shape>
  </composition>
  <audioMix sampleRate="48000" channels="2" bitDepth="24">
    <bus id="bus-music" volume="0.9">
      <audioEffect type="eq">
        <band kind="highpass" frequency="60"/>
        <band kind="peak" frequency="330" gain="-3" q="1.2"/>
      </audioEffect>
    </bus>
    <bus id="bus-fx" gain="-3">
      <audioEffect type="reverb" roomSize="0.4" amount="0.3"/>
    </bus>
    <audioTrack id="trk-music" asset="aud-music" role="music" bus="bus-music" fadeIn="0.5" fadeOut="1"
                fadeCurve="s-curve" duckUnder="trk-voice" duckAmount="-10" duckThreshold="-40"
                duckAttack="0.1" duckRelease="0.3"/>
    <audioTrack id="trk-voice" asset="aud-voice" role="voiceover" gain="-2">
      <animate property="pan">
        <key time="0" value="-0.5"/>
        <key time="4" value="0.5"/>
      </animate>
      <audioEffect type="compressor" threshold="-20" ratio="3" attack="0.005" release="0.08" gain="2"/>
    </audioTrack>
    <audioTrack id="trk-click" asset="aud-click" role="effects" startMarker="m-click" bus="bus-fx" loop="2" volume="0.8">
      <animate property="volume">
        <key time="0.5" value="0.8"/>
        <key time="0.8" value="0.3"/>
      </animate>
    </audioTrack>
    <master normalize="integrated" loudness="-16" truePeak="-1" dither="true"/>
  </audioMix>
  <captions>
    <captionTrack id="cap-en" language="en" mode="sidecar" format="srt">
      <cue start="1" end="2" text="One"/>
      <cue start="2.5" end="3" text="Two"/>
    </captionTrack>
  </captions>
</scene>
