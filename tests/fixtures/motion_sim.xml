<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation and geometry-modifier demo for scenerender (companion of motion_demo.xml):
     rigid-body shapes (capsule, polygon, path, convex-hull), a bullet, hinge limits, motor, slider,
     soft bodies (cloth, jelly, rope), particles colliding with body alpha and drawing trails, puppet
     (ARAP), skin, node IK, exact offset/merge/trim. 1280x720, 5 s. -->
<scene version="1.1">
  <project width="1280" height="720" fps="30" duration="5" seed="11" background="#0B0F1AFF"/>
  <assets>
    <generator id="checker" kind="checkerboard" width="160" height="160" paint="#F4F6FBFF" paint2="#3DD6D0FF" scale="20"/>
    <generator id="stripes" kind="stripes" width="240" height="140" paint="#FF5A36FF" paint2="#FFC23DFF" scale="20" angle="90"/>
  </assets>
  <composition>
    <!-- ======== rigid shapes: left -->
    <shape id="floor" shape="rect" x="0" y="690" width="1280" height="30" fill="#2A3350FF"><rigidBody type="static" friction="0.8"/></shape>
    <shape id="ramp" shape="rect" x="20" y="430" width="360" height="16" rotation="14" fill="#3A4466FF"><rigidBody type="static" friction="0.3"/></shape>
    <shape id="cap" shape="rounded-rect" x="60" y="300" width="110" height="36" radius="18" fill="#2EC4B6FF">
      <rigidBody shape="capsule" restitution="0.1"/>
    </shape>
    <shape id="tri" shape="path" path="M0 70 L80 70 L40 0 Z" x="200" y="220" width="80" height="70" fill="#FFC23DFF">
      <rigidBody shape="polygon" path="0 70 80 70 40 0" activateAt="0.4"/>
    </shape>
    <shape id="star" shape="star" x="280" y="120" width="90" height="90" points="5" fill="#FF4FA3FF">
      <rigidBody shape="path" activateAt="0.8" restitution="0.2"/>
    </shape>
    <shape id="blob" shape="ellipse" x="120" y="120" width="70" height="50" fill="#6B4BFFFF">
      <rigidBody shape="convex-hull" activateAt="1.2"/>
    </shape>
    <!-- bullet against a thin wall -->
    <shape id="wall" shape="rect" x="470" y="520" width="6" height="170" fill="#8A93A6FF"><rigidBody type="static"/></shape>
    <shape id="shot" shape="ellipse" x="400" y="600" width="14" height="14" fill="#F4F6FBFF">
      <rigidBody shape="circle" velocityX="30" velocityY="3" bullet="true" restitution="0.5" activateAt="1"/>
    </shape>

    <!-- ======== joints: middle -->
    <shape id="arm1" shape="rect" x="560" y="120" width="120" height="14" anchorY="7" fill="#FF5A36FF"><rigidBody/></shape>
    <shape id="arm2" shape="rect" x="680" y="120" width="100" height="14" anchorY="7" fill="#FFC23DFF"><rigidBody/></shape>
    <shape id="wheel" shape="star" x="600" y="330" width="120" height="120" points="6" fill="#2EC4B6FF">
      <rigidBody shape="circle" angularDamping="0"/>
    </shape>
    <shape id="rail" shape="rect" x="560" y="505" width="220" height="4" fill="#3A4466FF" rotation="-20"/>
    <shape id="sled" shape="rect" x="650" y="480" width="40" height="24" fill="#6B4BFFFF" rotation="-20"><rigidBody/></shape>

    <!-- ======== soft bodies: right -->
    <shape id="flag-pole" shape="rect" x="880" y="90" width="8" height="300" fill="#8A93A6FF"/>
    <layer id="flag" asset="stripes" x="888" y="92">
      <softBody kind="cloth" pin="left" rows="7" cols="10" stiffness="120" damping="0.25" mass="0.4"/>
    </layer>
    <shape id="jelly" shape="rounded-rect" x="1120" y="200" width="120" height="100" radius="24" fill="#3DD6D0FF">
      <softBody kind="jelly" rows="5" cols="6" stiffness="400" damping="0.3" pressure="300" mass="1"/>
    </shape>
    <shape id="rope" shape="rect" x="880" y="420" width="260" height="12" fill="#FFC23DFF">
      <softBody kind="rope" pin="corners" rows="2" cols="16" stiffness="300" damping="0.4" mass="0.2"/>
    </shape>

    <!-- particles with trails, bouncing off the jelly and the wheel -->
    <particleEmitter id="rain" x="1100" y="-10" emitterShape="line" emitterWidth="300" rate="60" lifetime="2.5" speed="80"
                     direction="90" spread="10" gravityY="500" size="4" color="#F4F6FBFF" colorEnd="#8FD8FF00"
                     trail="0.12" shape="disc" collide="true" bounce="0.5" seed="21" blend="add"/>
    <particleEmitter id="flow" x="560" y="40" emitterShape="point" rate="30" lifetime="3" speed="120" direction="30"
                     spread="20" size="5" color="#FF4FA3FF" colorEnd="#6B4BFF00" shape="streak" trail="0.25"
                     forceFields="ff-path" seed="22" blend="add"/>

    <!-- ======== deformers: puppet, skin, IK -->
    <layer id="pup" asset="checker" x="40" y="500" scaleX="0.8" scaleY="0.8">
      <deform>
        <modifier type="puppet">
          <pin restX="20" restY="80"/>
          <pin restX="140" restY="80">
            <animate property="y"><key time="0" value="0"/><key time="2" value="-50"/><key time="4" value="40"/></animate>
          </pin>
          <pin kind="starch" restX="80" restY="80" amount="1"/>
        </modifier>
      </deform>
    </layer>
    <skeleton id="sk">
      <bone id="b0" x="240" y="560" length="80"/>
      <bone id="b1" parent="b0" x="80" y="0" length="80">
        <animate property="rotation"><key time="0" value="0"/><key time="2.5" value="-70"/><key time="5" value="0"/></animate>
      </bone>
    </skeleton>
    <shape id="skinned" shape="rounded-rect" x="240" y="545" width="160" height="30" radius="12" fill="#FF5A36FF">
      <deform><modifier type="skin" skeleton="sk"/></deform>
    </shape>
    <shape id="goal" shape="ellipse" x="1000" y="560" width="16" height="16" anchorX="8" anchorY="8" fill="#FF4FA3FF">
      <motionPath path="M1000 560 C1080 480 1180 520 1180 600 S1060 680 1000 560"/>
    </shape>
    <shape id="ik-up" shape="rect" x="860" y="640" width="90" height="12" anchorY="6" rotation="-60" fill="#F4F6FBFF"/>
    <shape id="ik-lo" parent="ik-up" shape="rect" x="90" y="6" width="90" height="12" anchorY="6" fill="#C9D1E0FF"/>
    <shape id="ik-hand" parent="ik-lo" shape="ellipse" x="90" y="6" width="14" height="14" anchorX="7" anchorY="7" fill="#FFC23DFF">
      <transformConstraint type="ik" target="goal" bendPositive="false"/>
    </shape>

    <!-- ======== exact shape modifiers -->
    <shape id="merge" shape="path" x="1000" y="20" width="120" height="120" fill="#6B4BFFFF"
           path="M60 0 A60 60 0 1 1 59.9 0 Z M100 60 A40 40 0 1 1 99.9 60 Z">
      <shapeModifier type="merge" mode="subtract"/>
      <shapeModifier type="offset-path" amount="4" mode="round"/>
    </shape>
    <shape id="trim" shape="path" x="1150" y="30" width="100" height="100" fill="#00000000" stroke="#3DD6D0FF" strokeWidth="5"
           path="M0 0 L100 0 M0 50 L100 50 M0 100 L100 100">
      <shapeModifier type="trim" offset="0">
        <animate property="amount"><key time="0" value="100"/><key time="3" value="0"/></animate>
      </shapeModifier>
    </shape>
  </composition>
  <physics gravityY="-9.80665" pixelsPerMeter="100" bounds="frame" solverIterations="10">
    <forceField id="ff-wind" type="wind" forceX="4" forceY="0.5" strength="0.6" affects="bodies"/>
    <forceField id="ff-path" type="attractor-path" path="M560 60 C760 20 820 260 1000 200" strength="400" forceX="150"
                radius="160" affects="particles"/>
    <constraint id="c-shoulder" type="hinge" a="arm1" x="560" y="127"/>
    <constraint id="c-elbow" type="hinge" a="arm1" b="arm2" x="680" y="127" minAngle="-45" maxAngle="45"/>
    <constraint id="c-motor" type="motor" a="wheel" motorSpeed="120" maxForce="2"/>
    <constraint id="c-slide" type="slider" a="sled" axisAngle="-20" restLength="0.8"/>
  </physics>
</scene>
